/**
 * TypeScript 配置文件 - tsconfig.json
 * 
 * 功能：配置 TypeScript 编译选项
 */

{
  "compilerOptions": {
    // 模块系统：CommonJS（Node.js 默认）
    "module": "CommonJS",
    
    // 模块解析策略：Node 风格
    "moduleResolution": "node",
    
    // 目标 ECMAScript 版本：ES2020
    "lib": ["ES2020"],
    "target": "ES2020",
    
    // 启用严格模式（严格类型检查）
    "strict": true,
    
    // 跳过库检查（加速编译）
    "skipLibCheck": true,
    
    // 增量编译（加速后续编译）
    "incremental": true,
    
    // 输出目录：dist/
    "outDir": "dist",
    
    // 源码根目录
    "rootDir": ".",
    
    // 生成 Source Map（调试用）
    "sourceMap": true,
    
    // 允许导入 JSON 模块
    "resolveJsonModule": true,
    
    // 允许编译 JavaScript 文件
    "allowJs": true,
    
    // 强制文件名大小写一致
    "forceConsistentCasingInFileNames": true,
    
    // 启用 ES 模块互操作
    "esModuleInterop": true
  },
  
  // 需要编译的目录
  "include": ["src", "scripts", "config", "database"],
  
  // 排除的目录
  "exclude": ["node_modules", "dist", "build"]
}
