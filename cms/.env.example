# Strapi CMS 环境变量（POC 本地开发）

# 应用密钥（生产环境必须使用强随机值，不进 Git）
APP_KEYS=poc-key-1,poc-key-2

# JWT 密钥
JWT_SECRET=poc-jwt-secret
ADMIN_JWT_SECRET=poc-admin-jwt-secret

# API Token 盐
API_TOKEN_SALT=poc-api-token-salt

# Transfer Token 盐
TRANSFER_TOKEN_SALT=poc-transfer-token-salt

# 数据库（POC 默认 SQLite，生产切换 PostgreSQL）
DATABASE_CLIENT=sqlite
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false

# 服务端口
HOST=0.0.0.0
PORT=1337

# Webhook 签名密钥（CI 侧校验用）
WEBHOOK_SECRET=poc-webhook-secret
