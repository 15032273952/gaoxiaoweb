{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "单页",
    "description": "学校概况等单页内容"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "unique": true
    },
    "summary": {
      "type": "text"
    },
    "body": {
      "type": "richtext"
    },
    "template": {
      "type": "enumeration",
      "enum": [
        "default",
        "withSidebar",
        "openness"
      ],
      "default": "default"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::page.page"
    },
    "attachments": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    }
  }
}
