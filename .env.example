# SSH 远程部署连接信息（复制为 .env 并填写真实值；.env 已被 .gitignore 忽略，不会提交）
# ssh_exec.py / deploy_static.py / harden_server.py 会自动加载项目根目录的 .env
#
# 安全基线（2026-08-24 起）：服务器 SSH 仅密钥登录（harden_server.py 已禁用密码认证），
# 推荐配置 SSH_KEY；SSH_PASSWORD 仅在首次加固（尚未部署密钥）时临时使用。
SSH_HOST=186.241.89.117
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
# 私钥路径（推荐；与密码二选一，同时配置时密钥优先）
# SSH_KEY=

# 站点公开地址（静态构建注入 sitemap/RSS，默认 https://zcmwxy.duckdns.org）
# SITE_URL=https://zcmwxy.duckdns.org
